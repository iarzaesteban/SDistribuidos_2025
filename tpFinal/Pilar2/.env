REDIS_PASSWORD=thebestpassever

#Rabbit-MQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
EARRING_QUEUE=earring
IN_PROGRESS_QUEUE=in_progress

# Bloque Génesis
CHALLENGE=000
RESOLUTION_INTERVAL=120  # 20 * 60 ->> 2 minutos
MAX_MINING_TRYS=2
TIMEOUT_RESULTS_SEG=60
MAX_COINS=20000000
HASH_ALGORITHM=sha1

#Intervalo para el mover para pasar TX de la cola de earrings a la de in_progress y monitoring_in_progress
POLL_INTERVAL=30 # 30 segundos
COORDINATOR_URL=http://nct:8989
# Para decirle al worker que no procese un TX
MOCK_TASK_WORKER=True

TOTAL_NONCE_RANGE=4000000 #Para particionar TX para workers
BASE_DIFFICULTY=4 # Para calcular dificultad para workers
TASK_ASSIGN_INTERVAL=60 # Cada cuanto pide el pool TXs al coordinador 1min

# Configuración por entorno
WORKER_MODE= "COORDINADOR" # Forma de conexión del worker, por POOL o COORDINADOR 
POOL_URL=http://pool:9998
WORKER_TYPE=CPU